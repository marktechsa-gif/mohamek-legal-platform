# قاعدة البيانات
DATABASE_URL=postgresql://user:password@localhost:5432/asanid

# المصادقة
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=7d

# مزوّد الذكاء الاصطناعي: anthropic أو openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# الخادم
PORT=4000
CORS_ORIGIN=http://localhost:3000

# تخزين المستندات المرفوعة (محلي في الـ MVP)
UPLOADS_DIR=./uploads
