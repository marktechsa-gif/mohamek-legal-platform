# قاعدة البيانات
DATABASE_URL=postgresql://user:password@localhost:5432/smart_mro

# المصادقة
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=7d

# مزوّد الذكاء الاصطناعي لمساعد التشخيص: anthropic أو openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# الخادم
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ZATCA — بيانات البائع الافتراضية المستخدمة في QR الفاتورة عند عدم توفرها على مستوى الورشة
ZATCA_DEFAULT_SELLER_NAME=

# تخزين الملفات (صور أضرار المركبة) — محلي في الـ MVP
UPLOADS_DIR=./uploads
